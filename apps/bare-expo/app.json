}

function DoctorScreen({ onLogout }) {
  const patients = [
    { n: 'Ravi Kumar', d: 'T2 diabetes · sugar 112 today', b: 'Stable', warn: false },
    { n: 'Meena Deshpande', d: 'Sugar 264 after lunch', b: 'High sugar', warn: true },
    { n: 'Arjun Joshi', d: 'Missed 3 doses this week', b: 'Missed meds', warn: true },
  ];
  return (
    <ScrollView contentContainerStyle={s.page}>
      <Text style={s.muted}>Doctor ID · DR-48213</Text>
      <Text style={s.h2}>Dr. Anita Sharma</Text>
      <Text style={s.section}>My patients</Text>
      <Card style={{ padding: 0 }}>
        {patients.map((p, i) => (
          <View key={p.n} style={[s.listRow, i > 0 && s.listDivider]}>
            <View style={{ flex: 1 }}>
              <Text style={{ fontWeight: '600', color: C.ink }}>{p.n}</Text>
              <Text style={[s.muted, { fontSize: 12 }]}>{p.d}</Text>
            </View>
            <Badge
              label={p.b}
              bg={p.warn ? C.warnSoft : C.accentSoft}
              fg={p.warn ? C.warnInk : '#0B5A54'}
            />
          </View>
        ))}
      </Card>
      <Text style={[s.muted, { fontSize: 12 }]}>Doctor side is a preview. Full version comes after the database is set up.</Text>
      <Button title="Log out" outline onPress={onLogout} />
    </ScrollView>
  );
}

// ---------- App with bottom tabs ----------
const TABS = [
  { key: 'home', label: 'Home' },
  { key: 'sugar', label: 'Sugar' },
  { key: 'meds', label: 'Medicines' },
  { key: 'activity', label: 'Activity' },
  { key: 'profile', label: 'Profile' },
];

export default function App() {
  const [role, setRole] = useState(null);
  const [tab, setTab] = useState('home');
  const [sugar, setSugar] = useState(START_SUGAR);
  const [meds, setMeds] = useState(START_MEDS);

  const logout = () => { setRole(null); setTab('home'); };

  let body;
  if (!role) body = <LoginScreen onLogin={setRole} />;
  else if (role === 'doctor') body = <DoctorScreen onLogout={logout} />;
  else if (tab === 'home') body = <HomeScreen sugar={sugar} meds={meds} setMeds={setMeds} go={setTab} />;
  else if (tab === 'sugar') body = <SugarScreen sugar={sugar} setSugar={setSugar} />;
  else if (tab === 'meds') body = <MedsScreen meds={meds} setMeds={setMeds} />;
  else if (tab === 'activity') body = <ActivityScreen />;
  else body = <ProfileScreen onLogout={logout} />;

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: C.bg }}>
      <StatusBar barStyle="dark-content" />
      <View style={{ flex: 1 }}>{body}</View>
      {role === 'patient' && (
        <View style={s.tabBar}>
          {TABS.map((t) => (
            <TouchableOpacity key={t.key} style={s.tabItem} onPress={() => setTab(t.key)}>
              <View style={[s.tabDot, tab === t.key && { backgroundColor: C.accent }]} />
              <Text style={[s.tabText, tab === t.key && { color: C.accent, fontWeight: '700' }]}>{t.label}</Text>
            </TouchableOpacity>
          ))}
        </View>
      )}
    </SafeAreaView>
  );
}

// ---------- Styles ----------
const s = StyleSheet.create({
  page: { padding: 20, gap: 14, paddingBottom: 40 },
  h1: { fontSize: 30, fontWeight: '700', color: C.ink, lineHeight: 36 },
  h2: { fontSize: 24, fontWeight: '700', color: C.ink },
  muted: { color: C.muted, fontSize: 14, lineHeight: 20 },
  label: { fontSize: 13, fontWeight: '600', color: C.muted },
  section: { fontSize: 15, fontWeight: '700', color: C.ink, marginTop: 4 },
  card: { backgroundColor: C.card, borderRadius: 14, borderWidth: 1, borderColor: C.line, padding: 14 },
  logo: { width: 56, height: 56, borderRadius: 16, backgroundColor: C.accent, alignItems: 'center', justifyContent: 'center' },
  roleBox: { flex: 1, padding: 18, borderRadius: 14, borderWidth: 2, borderColor: C.line, backgroundColor: C.card },
